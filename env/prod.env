# Centralized environment configuration — PROD
# Passed to docker-compose with: docker compose --env-file env/prod.env ...
# Every service reads SPRING_PROFILES_ACTIVE and activates its
# application-prod.yml (see each service's src/main/resources/).
#
# SECURITY NOTE: these are placeholder demo values checked into the repo for
# convenience. A real prod deployment must NOT keep passwords/secrets in a
# committed file — source them from a secrets manager (Vault, AWS Secrets
# Manager, Kubernetes Secrets, etc.) and inject them at deploy time instead.

SPRING_PROFILES_ACTIVE=prod

MYSQL_ROOT_PASSWORD=changeme-prod
DB_USER=root
DB_PASSWORD=changeme-prod

# Shorter-lived tokens in prod
JWT_EXPIRATION_SECONDS=900
