# Centralized environment configuration — TEST
# Passed to docker-compose with: docker compose --env-file env/test.env ...
# Every service reads SPRING_PROFILES_ACTIVE and activates its
# application-test.yml (see each service's src/main/resources/).
#
# Note: test profile uses ddl-auto=create-drop on the DB-backed services,
# so schemas are wiped and recreated fresh on every restart — expected for
# automated test runs, not for data you want to keep.

SPRING_PROFILES_ACTIVE=test

MYSQL_ROOT_PASSWORD=root
DB_USER=root
DB_PASSWORD=root

# Short-lived tokens, useful for exercising expiry/re-login in tests
JWT_EXPIRATION_SECONDS=600
