# Centralized environment configuration — STAGE
# Passed to docker-compose with: docker compose --env-file env/stage.env ...
# Every service reads SPRING_PROFILES_ACTIVE and activates its
# application-stage.yml (see each service's src/main/resources/).
#
# In a real deployment these values (especially passwords) would come from a
# secrets manager, not a checked-in file — see prod.env for the same note.

SPRING_PROFILES_ACTIVE=stage

MYSQL_ROOT_PASSWORD=changeme-stage
DB_USER=root
DB_PASSWORD=changeme-stage

JWT_EXPIRATION_SECONDS=1800
