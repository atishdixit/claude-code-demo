# Centralized environment configuration — DEV
# Passed to docker-compose with: docker compose --env-file env/dev.env ...
# Every service reads SPRING_PROFILES_ACTIVE and activates its
# application-dev.yml (see each service's src/main/resources/).

SPRING_PROFILES_ACTIVE=dev

# Shared MySQL credentials (single instance, 3 logical databases)
MYSQL_ROOT_PASSWORD=root
DB_USER=root
DB_PASSWORD=root

# JWT token lifetime, in seconds (dev: long-lived, convenient for manual testing)
JWT_EXPIRATION_SECONDS=3600
